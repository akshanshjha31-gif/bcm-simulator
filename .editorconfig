root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,h,cpp,hpp}]
indent_size = 4
max_line_length = 100

[Makefile]
indent_style = tab

[*.{cs,xaml,csproj,sln}]
end_of_line = crlf

[*.{md,yml,yaml,json}]
indent_size = 2
