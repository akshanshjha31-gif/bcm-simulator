# ==========================================================================
#  Doxygen configuration - Automotive Body Control Module (BCM) Simulator
#
#  Generate with:   tools\bcm.ps1 docs
#  Output:          docs/api/html/index.html
#
#  Vendor code (STM32 HAL, CMSIS, FreeRTOS) is deliberately excluded: it is
#  fetched rather than committed, and documenting it would bury the project's
#  own ~30 modules under several thousand vendor pages.
# ==========================================================================

PROJECT_NAME           = "BCM Simulator"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "Automotive Body Control Module - STM32F103, FreeRTOS, C++14"

OUTPUT_DIRECTORY       = api
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

# ---- What to document ----------------------------------------------------
INPUT                  = ../firmware/common \
                         ../firmware/bsp \
                         ../firmware/drivers \
                         ../firmware/services \
                         ../firmware/app \
                         ../firmware/core \
                         ../sil \
                         mainpage.dox

FILE_PATTERNS          = *.h *.hpp *.c *.cpp *.dox
RECURSIVE              = YES

EXCLUDE                = ../firmware/vendor
EXCLUDE_PATTERNS       = */vendor/* */build/* */stm32f1xx_hal_conf.h

# ---- Extraction ----------------------------------------------------------
# The service layer keeps its invariants in private members and anonymous
# namespaces (the FSM tables, for instance), so those are included: hiding
# them would omit exactly the parts a reviewer needs to see.
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = YES
HIDE_UNDOC_MEMBERS     = NO
INTERNAL_DOCS          = YES

JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MULTILINE_CPP_IS_BRIEF = NO
INHERIT_DOCS           = YES
TAB_SIZE               = 4
OPTIMIZE_OUTPUT_FOR_C  = NO
BUILTIN_STL_SUPPORT    = YES

# ---- Preprocessing -------------------------------------------------------
# Without these the parser sees the target-only branches only, and misses the
# host-compilable half of every driver.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = ../firmware/drivers ../firmware/services ../firmware/bsp
PREDEFINED             = USE_HAL_DRIVER \
                         STM32F103xB \
                         __cplusplus=201402L \
                         DOXYGEN_RUNNING

# ---- Output --------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = TOGGLE
HTML_DYNAMIC_SECTIONS  = YES
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = NO
DISABLE_INDEX          = NO
SEARCHENGINE           = YES

GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

# ---- Diagrams ------------------------------------------------------------
# Graphviz is not assumed to be present, so only the built-in diagrams are
# enabled. Install Graphviz and set HAVE_DOT=YES for full call graphs; the
# hand-authored UML in docs/uml/ does not depend on it either way.
HAVE_DOT               = NO

# ---- Warnings ------------------------------------------------------------
# Undocumented public API is a real defect in a project whose selling point
# is its documentation, so surface it rather than staying quiet.
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO
WARN_LOGFILE           = api/doxygen-warnings.log

# ---- Source browsing -----------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
VERBATIM_HEADERS       = YES

ALPHABETICAL_INDEX     = YES
