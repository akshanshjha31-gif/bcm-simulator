<Window x:Class="BcmDiagnosticTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BcmDiagnosticTool"
        Title="BCM Diagnostic Tool" Height="720" Width="1080"
        MinHeight="560" MinWidth="900">

    <Window.Resources>
        <local:BoolToLampBrushConverter x:Key="LampBrush" />
        <local:BoolToHealthBrushConverter x:Key="HealthBrush" />
        <local:FaultToBrushConverter x:Key="FaultBrush" />
    </Window.Resources>

    <DockPanel>

        <!-- ===== Connection bar ===== -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Margin="6,6,6,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="PORT" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding Ports}"
                          SelectedItem="{Binding SelectedPort}"
                          IsEnabled="{Binding IsConnected, Converter={x:Static local:Inverse.Bool}}" />
                <Button Content="Refresh" Command="{Binding RefreshPortsCommand}" Margin="6,0,6,0" />
                <Button Content="{Binding ConnectButtonText}" Command="{Binding ConnectCommand}" />

                <Ellipse Width="10" Height="10" Margin="18,0,8,0"
                         Fill="{Binding LinkHealthy, Converter={StaticResource HealthBrush}}" />
                <TextBlock Text="{Binding ConnectionState}" VerticalAlignment="Center" />

                <TextBlock Text="  |  FIRMWARE " Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="18,0,0,0" />
                <TextBlock Text="{Binding FirmwareVersion}" VerticalAlignment="Center" />

                <TextBlock Text="{Binding Statistics}" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="24,0,0,0" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Left: live vehicle state ===== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Lamps -->
                <Border Grid.Row="0" Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="LAMPS" Style="{StaticResource SectionHeader}" />
                        <ItemsControl ItemsSource="{Binding Lamps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="126" Height="54" Margin="0,0,8,8"
                                            Command="{Binding DataContext.SetLampCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Click to drive this lamp over the diagnostic link">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="14" Height="14" Margin="0,0,10,0"
                                                     Fill="{Binding IsOn, Converter={StaticResource LampBrush}}" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Switches + power + battery -->
                <Border Grid.Row="1" Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="INPUTS" Style="{StaticResource SectionHeader}" />
                        <ItemsControl ItemsSource="{Binding Switches}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="126" Height="34" Margin="0,0,8,8"
                                            Background="#252B35" CornerRadius="4">
                                        <StackPanel Orientation="Horizontal" Margin="10,0"
                                                    VerticalAlignment="Center">
                                            <Ellipse Width="10" Height="10" Margin="0,0,10,0"
                                                     Fill="{Binding IsPressed, Converter={StaticResource LampBrush}}" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,28,0">
                                <TextBlock Text="POWER STATE" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding PowerState}" FontSize="19" FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="BATTERY" Style="{StaticResource Caption}" />
                                <TextBlock FontSize="19" FontWeight="SemiBold">
                                    <TextBlock.Text>
                                        <Binding Path="BatteryPercent" StringFormat="{}{0:F1} %" />
                                    </TextBlock.Text>
                                </TextBlock>
                                <!-- OneWay: ProgressBar.Value binds TwoWay by
                                     default, which throws on a read-only
                                     source property. -->
                                <ProgressBar Value="{Binding BatteryPercent, Mode=OneWay}"
                                             Maximum="100" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <Border Grid.Row="2" Style="{StaticResource Panel}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="ACTIONS" Style="{StaticResource SectionHeader}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Lock doors" Command="{Binding LockCommand}" />
                            <Button Content="Unlock doors" Command="{Binding UnlockCommand}" />
                            <Button Content="Clear DTCs" Command="{Binding ClearDtcCommand}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Text="Lock may answer NOT PERMITTED - the BCM refuses to lock while a door is open (SRS-DOOR-002). Lamp requests are merged before safety arbitration, so the reverse lamp stays dark without reverse gear." />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Right: DTCs and events ===== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="ACTIVE FAULT CODES" Style="{StaticResource SectionHeader}" />
                        <ListBox ItemsSource="{Binding Dtcs}" MaxHeight="120" />
                        <TextBlock Text="No active DTCs">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Dtcs.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Panel}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <TextBlock Text="EVENT LOG" Style="{StaticResource SectionHeader}" />
                            <Button Content="Clear" Command="{Binding ClearEventsCommand}"
                                    HorizontalAlignment="Right" Padding="8,2" Margin="0,-4,0,0" />
                        </Grid>
                        <ListBox ItemsSource="{Binding Events}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="{Binding Timestamp}" Width="86"
                                                   Foreground="#8B94A3" FontFamily="Consolas" />
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                   Foreground="{Binding IsFault, Converter={StaticResource FaultBrush}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
